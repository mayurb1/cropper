{
  "name": "react-pixcraft",
  "version": "1.0.7",
  "description": "Lightweight React image editor with crop, rotate, flip, and scale. Uses only React + native Canvas API.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "keywords": [
    "react",
    "image",
    "editor",
    "crop",
    "rotate",
    "flip",
    "canvas"
  ],
  "author": "Mayur Bhalgama",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
